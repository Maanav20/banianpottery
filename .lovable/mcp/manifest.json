{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "banian-pottery-mcp",
      "version": "0.1.0",
      "title": "Banian Pottery"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List pottery catalog",
        "description": "List handcrafted pottery pieces from the Banian Pottery catalog with name, dimensions, weight, and availability status. Optionally filter by status or search text in the piece name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "available",
                "sold-out",
                "defect"
              ],
              "description": "Filter by availability status."
            },
            "search": {
              "type": "string",
              "description": "Case insensitive substring match against the piece name."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum number of items to return. Default 50."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get pottery piece details",
        "description": "Get full details for a single pottery piece by its numeric catalog id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1,
              "description": "Catalog id (1 to 45)."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_workshops",
        "title": "List pottery workshops",
        "description": "List available one day pottery workshops at Banian Pottery with name, duration, group size, tagline, description, and price.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_studio_info",
        "title": "Get studio info",
        "description": "Get an overview of Banian Pottery: what the studio does and how to get in touch.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
